<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral services and view-models shared by the Windows (WPF) and macOS (Avalonia) front ends. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Meili.Shared</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meili.Application/Meili.Application.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ScottPlot" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meili.Core\Meili.Core.csproj" />
    <ProjectReference Include="..\Meili.Data\Meili.Data.csproj" />
    <ProjectReference Include="..\Meili.Analytics\Meili.Analytics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/NavigationIcons/LICENSE" LogicalName="NavigationIcons/LICENSE" />
    <EmbeddedResource Include="WebCharts/index.html" LogicalName="WebCharts/index.html" />
    <EmbeddedResource Include="Assets/Fonts/*" LogicalName="WebCharts/fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="WebCharts/design-tokens.css" LogicalName="WebCharts/design-tokens.css" />
    <EmbeddedResource Include="WebCharts/components.css" LogicalName="WebCharts/components.css" />
    <EmbeddedResource Include="WebCharts/motion.js" LogicalName="WebCharts/motion.js" />
    <EmbeddedResource Include="WebCharts/icons.js" LogicalName="WebCharts/icons.js" />
    <EmbeddedResource Include="WebCharts/chart.js" LogicalName="WebCharts/chart.js" />
    <EmbeddedResource Include="WebCharts/workbench.html" LogicalName="WebCharts/workbench.html" />
    <EmbeddedResource Include="WebCharts/workbench.js" LogicalName="WebCharts/workbench.js" />
    <EmbeddedResource Include="WebCharts/vendor/lightweight-charts.js" LogicalName="WebCharts/vendor/lightweight-charts.js" />
    <EmbeddedResource Include="WebCharts/vendor/LICENSE" LogicalName="WebCharts/vendor/LICENSE" />
    <EmbeddedResource Include="WebCharts/vendor/NOTICE" LogicalName="WebCharts/vendor/NOTICE" />
    <EmbeddedResource Include="WebCharts/vendor/provenance.json" LogicalName="WebCharts/vendor/provenance.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- One copy of the UI text: the WPF string dictionaries, read as plain key/value pairs on every platform
         (WithCulture=false: kept in the main assembly, not split into zh-CN/en-US satellite assemblies). -->
    <EmbeddedResource Include="..\Meili.App\Resources\Strings\Strings.zh-CN.xaml" LogicalName="Strings.zh-CN.xaml" WithCulture="false" />
    <EmbeddedResource Include="..\Meili.App\Resources\Strings\Strings.en-US.xaml" LogicalName="Strings.en-US.xaml" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MeiliTerminal" />
    <InternalsVisibleTo Include="Meili.App.Tests" />
    <InternalsVisibleTo Include="Meili.Shared.Tests" />
    <InternalsVisibleTo Include="MeiliMac" />
    <InternalsVisibleTo Include="Meili.Mac.Tests" />
  </ItemGroup>
</Project>
