<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:svc="clr-namespace:Meili.App.Services"
                    xmlns:ux="clr-namespace:Meili.App.Views.Controls"
                    xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../DesignSystem/Components.xaml" /></ResourceDictionary.MergedDictionaries>
    <svc:InverseBoolConverter x:Key="InverseBool" />
    <svc:BoolToVisConverter x:Key="BoolToVis" />
    <svc:BoolToVisConverter x:Key="InverseBoolToVis" Invert="True" />
    <svc:NonEmptyToVisConverter x:Key="NonEmptyToVis" />
    <svc:HealthIconConverter x:Key="HealthIcon" />
    <!-- Typography: nothing in the app is smaller than 12px. -->

    <!-- Defaults match ThemePalette.Dark; ThemeService overwrites every key after a theme apply. -->
    <SolidColorBrush x:Key="UpBrush" Color="#CC8E8A" />
    <SolidColorBrush x:Key="DownBrush" Color="#6EAA8A" />
    <SolidColorBrush x:Key="UpBackgroundBrush" Color="#18CC8E8A" />
    <SolidColorBrush x:Key="DownBackgroundBrush" Color="#186EAA8A" />
    <!-- Health/status colours are neutral so they never read as "up" or "down". State is also shown by an icon and a word. -->
    <SolidColorBrush x:Key="HealthyBrush" Color="#7EA6C0" />
    <SolidColorBrush x:Key="DegradedBrush" Color="#C4A46A" />
    <SolidColorBrush x:Key="DownStateBrush" Color="#9A958C" />
    <SolidColorBrush x:Key="UnknownBrush" Color="#9A958C" />
    <SolidColorBrush x:Key="StaleBadgeBrush" Color="#C4A46A" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#1A1816" />
    <SolidColorBrush x:Key="RowHighlightBrush" Color="#35322E" />
    <SolidColorBrush x:Key="ItmBrush" Color="#22C4B3D4" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1F1D1B" />
    <SolidColorBrush x:Key="ErrorBarBrush" Color="#3A2A28" />
    <SolidColorBrush x:Key="InfoBarBrush" Color="#2C2A28" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}"/>
        <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="LineHeight" Value="{StaticResource StatusLineHeight}"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="PageScroller" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="32,24,32,32" />
    </Style>
        <Style x:Key="WorkspaceTile" TargetType="ToggleButton">
            <Setter Property="Width" Value="56"/><Setter Property="Height" Value="52"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid>
                <Border x:Name="Pill" Width="4" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0"/>
                <Border x:Name="Tile" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource RowHighlightBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderThickness" Value="2"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    <Style x:Key="StatusAction" TargetType="p:ButtonBase"><Setter Property="ux:ComponentMotion.Enabled" Value="True"/>
        <Setter Property="Width" Value="28"/><Setter Property="Height" Value="{StaticResource StatusItemHeight}"/><Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="{StaticResource StatusItemHeight}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0,0,0"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:ButtonBase"><Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StatusToggle" TargetType="ToggleButton" BasedOn="{StaticResource StatusAction}"><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource RowHighlightBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
