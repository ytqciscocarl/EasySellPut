<Page x:Class="Meili.App.Views.Pages.SettingsPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:lucide="clr-namespace:Meili.App.Views.Controls"
    xmlns:ds="clr-namespace:Meili.App.Views.Controls"
    xmlns:ux="clr-namespace:Meili.App.Views.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Settings}" />

            <Border x:Name="UpdatePanel" DataContext="{Binding Updates}" Padding="16" Margin="0,16,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <ui:Button Content="{DynamicResource Upd_Check}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0"/>
                            <ui:Button Appearance="Primary" Content="{DynamicResource Upd_Download}" Command="{Binding DownloadUpdateCommand}" Visibility="{Binding ShowDownloadUpdate,Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                            <ui:Button Appearance="Primary" Content="{DynamicResource Upd_Install}" Command="{Binding InstallUpdateCommand}" Visibility="{Binding ShowInstallUpdate,Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                            <ui:Button Appearance="Transparent" Content="{DynamicResource Upd_OpenDownload}" Command="{Binding OpenUpdateFolderCommand}" Visibility="{Binding ShowUpdateFolder,Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                            <ui:Button Appearance="Transparent" Command="{Binding OpenUpdateHistoryCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Upd_History}" VerticalAlignment="Center"/><lucide:LucideIcon Kind="ExternalLink" Width="14" Height="14" Margin="6,0,0,0"/></StackPanel></ui:Button>
                        </WrapPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Upd_Title}"/><TextBlock Style="{StaticResource Caption}" Text="{Binding UpdateVersionLine}" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding UpdateStatusText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <DockPanel Visibility="{Binding ShowUpdateProgress,Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <ui:Button Appearance="Transparent" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" DockPanel.Dock="Right" Content="{lucide:Lucide Close}" Command="{Binding CancelUpdateCommand}" AutomationProperties.Name="{DynamicResource Upd_Cancel}" ToolTip="{DynamicResource Upd_Cancel}" Margin="8,0,0,0"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" IsIndeterminate="{Binding IsUpdateIndeterminate}" Height="4" MinHeight="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Expander Background="{DynamicResource ControlFillColorSecondaryBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Header="{DynamicResource Upd_Notes}" Visibility="{Binding HasUpdateNotes,Converter={StaticResource BoolToVis}}" HorizontalAlignment="Stretch" Margin="0,8,0,0"><TextBlock Text="{Binding UpdateNotes}" FontSize="14" FontWeight="Normal" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Appearance}" />
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide Language}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_Language}" HelpText="{DynamicResource Set_LanguageDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
                <ds:AppSelect Width="{StaticResource FormFieldWidth}" SelectedIndex="{Binding LanguageIndex}">
                    <ComboBoxItem Content="简体中文" />
                    <ComboBoxItem Content="English" />
                </ds:AppSelect>
            </ds:AppCard>
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide Theme}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_Theme}" HelpText="{DynamicResource Set_ThemeDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
                <ds:AppSelect Width="{StaticResource FormFieldWidth}" SelectedIndex="{Binding ThemeIndex}">
                    <ComboBoxItem Content="{DynamicResource Set_ThemeSystem}" />
                    <ComboBoxItem Content="{DynamicResource Set_ThemeLight}" />
                    <ComboBoxItem Content="{DynamicResource Set_ThemeDark}" />
                </ds:AppSelect>
            </ds:AppCard>
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide ArrowUpDown}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_UpDown}" HelpText="{DynamicResource Set_UpDownDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
                <ds:AppSelect Width="{StaticResource FormFieldWidth}" SelectedIndex="{Binding UpDownIndex}">
                    <ComboBoxItem Content="{DynamicResource Set_RedUp}" />
                    <ComboBoxItem Content="{DynamicResource Set_GreenUp}" />
                </ds:AppSelect>
            </ds:AppCard>

            <!-- Network -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Network}" />
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide Globe}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_ProxyMode}" HelpText="{DynamicResource Set_ProxyModeDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
                <ds:AppSelect Width="{StaticResource FormFieldWidth}" SelectedIndex="{Binding ProxyModeIndex}">
                    <ComboBoxItem Content="{DynamicResource Set_ProxyAuto}" />
                    <ComboBoxItem Content="{DynamicResource Set_ProxySystem}" />
                    <ComboBoxItem Content="{DynamicResource Set_ProxyManual}" />
                    <ComboBoxItem Content="{DynamicResource Set_ProxyDirect}" />
                </ds:AppSelect>
            </ds:AppCard>
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide Router}" IsEnabled="{Binding IsManualProxy}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_ManualProxy}" HelpText="{DynamicResource Set_ManualProxyDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
                <ui:TextBox Width="{StaticResource FormFieldWidth}" PlaceholderText="http://127.0.0.1:7890" Text="{Binding ManualProxy, UpdateSourceTrigger=PropertyChanged}" />
            </ds:AppCard>
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide DataSources}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Set_ProxyEffective}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding EffectiveProxy}" />
                    </StackPanel>
                </ds:AppCard.Header>
                <ui:Button Appearance="Primary" Content="{DynamicResource Set_ProxyApply}" Command="{Binding ApplyProxyCommand}" MinWidth="140" />
            </ds:AppCard>

            <!-- Close button (D4) -->
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide Close}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_CloseAction}" HelpText="{DynamicResource Set_CloseActionDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
                <ds:AppSelect Width="{StaticResource FormFieldWidth}" SelectedIndex="{Binding CloseActionIndex}" AutomationProperties.AutomationId="SettingsCloseAction">
                    <ComboBoxItem Content="{DynamicResource Set_CloseAsk}" />
                    <ComboBoxItem Content="{DynamicResource Close_ToTray}" />
                    <ComboBoxItem Content="{DynamicResource Close_Exit}" />
                </ds:AppSelect>
            </ds:AppCard>

            <!-- Keyboard (D2) -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Shortcuts}" />
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide Keyboard}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_ShortcutsTitle}" HelpText="{DynamicResource Set_ShortcutsDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
            </ds:AppCard>

            <!-- Pricing (F5) -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Pricing}" />
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide TrendUp}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_RateMode}" HelpText="{DynamicResource Set_RateModeDesc}"/>
                    </StackPanel>
                </ds:AppCard.Header>
                <ds:AppSelect Width="{StaticResource FormFieldWidth}" SelectedIndex="{Binding RateModeIndex}" AutomationProperties.AutomationId="SettingsRateMode">
                    <ComboBoxItem Content="{DynamicResource Set_RateTreasury}" />
                    <ComboBoxItem Content="{DynamicResource Set_RateFixedItem}" />
                </ds:AppSelect>
            </ds:AppCard>
            <ds:AppCard Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <lucide:LucideIcon Kind="Hash" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <ux:AppFormHeader Grid.Column="1" Title="{DynamicResource Set_FixedRate}" HelpText="{DynamicResource Set_FixedRateDesc}" Margin="0,0,20,0"/>
                    <ui:TextBox Grid.Column="2" Width="{StaticResource FormFieldWidth}" Text="{Binding FixedRateText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SettingsFixedRate"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding FixedRateError}" TextWrapping="Wrap" MaxWidth="{StaticResource FormFieldWidth}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding FixedRateError, Converter={StaticResource NonEmptyToVis}}"/>
                </Grid>
            </ds:AppCard>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_AiTitle}" />
            <ds:AppCard x:Name="AiSetupPanel" Margin="0,0,0,4"><ds:AppCard.Header>
                <StackPanel>
                    <Button Content="{DynamicResource Set_AiUniversal}" Command="{Binding CopyUniversalSetupCommand}" IsEnabled="{Binding CanConnectAi}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_AiStepCopy}" Margin="0,0,12,0"/>
                        <lucide:LucideIcon Kind="ArrowRight" Width="18" Height="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}"  Margin="0,0,12,0"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding AiTerminalLabel}" Margin="0,0,12,0"/>
                        <lucide:LucideIcon Kind="ArrowRight" Width="18" Height="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}"  Margin="0,0,12,0"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Set_AiStepSession}"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Border Width="280" Padding="12" Margin="0,0,12,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="{lucide:Lucide Help}" Padding="0" Width="24" Height="24" MinWidth="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenAiHelpCommand}" CommandParameter="codex" AutomationProperties.Name="{DynamicResource Set_AiHelp}" ToolTip="{DynamicResource Set_AiHelp}" Margin="8,0,0,0"/><TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding CodexAvailability}" VerticalAlignment="Center"/><TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="Codex" VerticalAlignment="Center"/></DockPanel>
                                <WrapPanel>
                                    <Button x:Name="ConnectCodex" Content="{DynamicResource Set_AiCodex}" Command="{Binding CopyCodexCommand}" IsEnabled="{Binding CanConnectAi}" AutomationProperties.AutomationId="ConnectCodex" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Set_AiPrompt}" Command="{Binding CopyAiPromptCommand}" CommandParameter="codex" IsEnabled="{Binding CanConnectAi}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Width="280" Padding="12" Margin="0,0,12,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="{lucide:Lucide Help}" Padding="0" Width="24" Height="24" MinWidth="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenAiHelpCommand}" CommandParameter="claude-code" AutomationProperties.Name="{DynamicResource Set_AiHelp}" ToolTip="{DynamicResource Set_AiHelp}" Margin="8,0,0,0"/><TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding ClaudeAvailability}" VerticalAlignment="Center"/><TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="Claude Code" VerticalAlignment="Center"/></DockPanel>
                                <WrapPanel>
                                    <Button x:Name="ConnectClaude" Content="{DynamicResource Set_AiClaude}" Command="{Binding CopyClaudeCommand}" IsEnabled="{Binding CanConnectAi}" AutomationProperties.AutomationId="ConnectClaude" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Set_AiPrompt}" Command="{Binding CopyAiPromptCommand}" CommandParameter="claude-code" IsEnabled="{Binding CanConnectAi}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding AiConnectionStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Expander Header="{DynamicResource Set_AiMore}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Codex"/>
                            <TextBox Text="{Binding CodexSetupCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Claude Code"/>
                            <TextBox Text="{Binding ClaudeSetupCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                            <Button Content="{DynamicResource Set_AiToml}" Command="{Binding CopyMcpTomlCommand}" IsEnabled="{Binding CanConnectAi}" HorizontalAlignment="Left" Margin="0,8" />
                            <TextBox Text="{Binding McpToml, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                            <Button Content="{DynamicResource Set_AiJson}" Command="{Binding CopyMcpJsonCommand}" IsEnabled="{Binding CanConnectAi}" HorizontalAlignment="Left" Margin="0,8" />
                            <TextBox Text="{Binding McpJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Text="{DynamicResource Set_AiPrivacy}" TextWrapping="Wrap" Margin="0,8" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ds:AppCard.Header></ds:AppCard>
            <!-- Storage -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_Storage}" />
            <ds:AppCard Margin="0,0,0,4" Icon="{lucide:Lucide Folder}">
                <ds:AppCard.Header>
                    <StackPanel>
                        <ux:AppFormHeader Title="{DynamicResource Set_DataDir}" HelpText="{DynamicResource Set_DataDirDesc}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding DataDirectory}" Margin="0,2,0,2" />

                    </StackPanel>
                </ds:AppCard.Header>
                <ui:Button Content="{DynamicResource Set_OpenFolder}" Command="{Binding OpenDataFolderCommand}" MinWidth="120" />
            </ds:AppCard>

            <!-- About -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Set_About}" />
            <ds:AppCard Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="pack://application:,,,/MeiliTerminal;component/Assets/app-64.png" Width="40" Height="40" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{DynamicResource App_Title}" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{DynamicResource Set_Company}" />
                                <Run Text="  ·  " />
                                <Run Text="{DynamicResource Set_Version}" />
                                <Run Text=" " />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AboutDescription" Style="{StaticResource Body}" Text="{DynamicResource Set_AboutDesc}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ds:AppCard>
        </StackPanel>
    </ScrollViewer>
</Page>
