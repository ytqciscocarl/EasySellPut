<Page x:Class="Meili.App.Views.Pages.DashboardPage"
      Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:lucide="clr-namespace:Meili.App.Views.Controls"
    xmlns:ds="clr-namespace:Meili.App.Views.Controls"
    xmlns:ux="clr-namespace:Meili.App.Views.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1200">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Nav_Dashboard}" />


            <!-- Hero -->


            <!-- D7: getting started (network/proxy, watchlist, options) until dismissed -->
            <ds:AppCard Padding="12" Margin="0,12,0,0" Visibility="{Binding ShowGuide, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="DashGuide"><DockPanel LastChildFill="True"><ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding DismissGuideCommand}" Content="{DynamicResource Dash_GuideDismiss}" Margin="12,0,0,0"/><WrapPanel><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource UX_QuickStart}" VerticalAlignment="Center" Margin="0,0,12,0"/><ui:Button Command="{Binding OpenWatchlistCommand}" Content="{DynamicResource Dash_Guide2Btn}" Margin="0,0,8,0"/><ui:Button Command="{Binding OpenOptionsCommand}" Content="{DynamicResource Dash_Guide3Btn}" Margin="0,0,8,0"/><ui:Button Command="{Binding OpenDataSourcesCommand}" Content="{DynamicResource Dash_OpenSources}" Margin="0,0,8,0"/></WrapPanel></DockPanel></ds:AppCard>

            <!-- Market overview (quotes via failover) -->
            <DockPanel Margin="0,24,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Dash_Market}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Command="{Binding RefreshCommand}" Padding="12,6" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <lucide:LucideIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Dash_Refresh}" />
                    </StackPanel>
                </ui:Button>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding StatusText}" />
            </DockPanel>
            <!-- D8: every source failed — prices below are the last ones received -->
            <ui:InfoBar Title="{DynamicResource Dash_AllFailedTitle}" Message="{Binding FailureBody}"
                        IsOpen="{Binding AllSourcesFailed}" IsClosable="False" Severity="Error" Margin="0,0,0,12"
                        AutomationProperties.AutomationId="DashAllFailed">
                <WrapPanel>
                    <ui:Button Appearance="Secondary" Margin="0,0,8,0" Command="{Binding RedetectProxyCommand}" Content="{DynamicResource Dash_Redetect}" Padding="10,4"
                               Visibility="{Binding ProxyMissing, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Appearance="Secondary" Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}" Content="{DynamicResource Dash_OpenSettings}" Padding="10,4"
                               Visibility="{Binding ProxyMissing, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Appearance="Secondary" Command="{Binding OpenDataSourcesCommand}" Content="{DynamicResource Dash_OpenSources}" Padding="10,4" />
                </WrapPanel>
            </ui:InfoBar>
            <ItemsControl ItemsSource="{Binding Quotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ds:AppCard Margin="0,0,8,8" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="False">
                                    <ui:Button DockPanel.Dock="Right" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Margin="6,0,0,0" Command="{Binding DataContext.OpenChartCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Symbol}" AutomationProperties.Name="{Binding ChartActionLabel}" ToolTip="{Binding ChartActionLabel}"><ux:LucideIcon Kind="Charts" Width="16" Height="16"/></ui:Button><TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            ToolTip="{Binding TimingTip}">
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceText}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,8" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PriceText}" FontFamily="{DynamicResource NumberFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="8,2" Background="{Binding ChangeBackground}">
                                        <TextBlock Text="{Binding ChangeText}" FontFamily="{DynamicResource NumberFont}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ChangeBrush}" />
                                    </Border>
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="6,1" Background="{DynamicResource StaleBadgeBrush}"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}" ToolTip="{Binding StaleTip}"
                                            AutomationProperties.AutomationId="StaleBadge">
                                        <TextBlock Text="{DynamicResource Quote_Stale}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BadgeTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ExtText}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding AsOfText}" ToolTip="{Binding TimingTip}" />
                                </StackPanel>
                            </Grid>
                        </ds:AppCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
