<controls:AppDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Meili.App.Views.Controls"
 x:Class="Meili.App.Views.UpdateDialog"
 Width="520" Title="{Binding UpdatePromptTitle}">
 <StackPanel Margin="24">
  <StackPanel>
   <controls:LucideIcon Kind="Download" Width="28" Height="28" HorizontalAlignment="Left"/>
   <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding UpdatePromptTitle}" TextWrapping="Wrap"/>
   <TextBlock Style="{StaticResource Caption}" Text="{Binding UpdateVersionLine}"/>
  </StackPanel>
  <ScrollViewer Margin="0,16,0,0" MaxHeight="240" Visibility="{Binding HasUpdateNotes,Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding UpdateNotes}" TextWrapping="Wrap"/></ScrollViewer>
  <TextBlock Style="{StaticResource Caption}" Text="{Binding UpdateStatusText}" TextWrapping="Wrap"/>
  <DockPanel Visibility="{Binding ShowUpdateProgress,Converter={StaticResource BoolToVis}}">
   <Button DockPanel.Dock="Right" Style="{StaticResource StatusAction}" Command="{Binding CancelUpdateCommand}" ToolTip="{DynamicResource Upd_Cancel}" AutomationProperties.Name="{DynamicResource Upd_Cancel}" Margin="8,0,0,0"><controls:LucideIcon Kind="Close"/></Button>
   <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" IsIndeterminate="{Binding IsUpdateIndeterminate}" Height="4" MinHeight="0" VerticalAlignment="Center"/>
  </DockPanel>
  <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Right">
   <Button x:Name="LaterButton" Content="{DynamicResource Upd_Later}" Command="{Binding DismissUpdatePromptCommand}" Margin="0,0,8,0" IsCancel="True"/>
   <Button Content="{DynamicResource Upd_OpenDownload}" Command="{Binding OpenUpdateFolderCommand}" Visibility="{Binding ShowUpdateFolder,Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
   <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Upd_Download}" Command="{Binding DownloadUpdateCommand}" Visibility="{Binding ShowDownloadUpdate,Converter={StaticResource BoolToVis}}"/>
   <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Upd_Install}" Command="{Binding InstallUpdateCommand}" Visibility="{Binding ShowInstallUpdate,Converter={StaticResource BoolToVis}}"/>
  </WrapPanel>
 </StackPanel>
</controls:AppDialog>
