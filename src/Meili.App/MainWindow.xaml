<ui:FluentWindow x:Class="Meili.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:lucide="clr-namespace:Meili.App.Views.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Meili.App.Views.Pages"
                 xmlns:controls="clr-namespace:Meili.App.Views.Controls"
                 Title="{DynamicResource App_Title}"
                 Width="1320" Height="840" MinWidth="980" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round"
                 FontFamily="{DynamicResource AppFont}"
                 FontSize="{StaticResource BodyFontSize}"
                 Typography.NumeralAlignment="Tabular"
                 Icon="pack://application:,,,/MeiliTerminal;component/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="" Height="{StaticResource WindowHeaderHeight}"
                     Background="{DynamicResource ApplicationBackgroundBrush}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}"
                     FontFamily="{DynamicResource AppFont}" FontSize="{StaticResource CaptionFontSize}">
        </ui:TitleBar>

        <Grid Grid.Row="1" x:Name="WorkspaceGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <ScrollViewer x:Name="SidebarScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel HorizontalAlignment="Center" Margin="0,8">
                        <ToggleButton x:Name="HomeWorkspace" Style="{StaticResource WorkspaceTile}" Click="OnHomeWorkspace" IsChecked="True" ToolTip="{DynamicResource Nav_Dashboard}" AutomationProperties.Name="{DynamicResource Nav_Dashboard}"><Image Source="pack://application:,,,/MeiliTerminal;component/Assets/app-64.png" Width="28" Height="28"/></ToggleButton>
                        <Border Height="1" Margin="16,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <StackPanel x:Name="BuiltinRail"/>
                        <Border Height="1" Margin="16,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <StackPanel x:Name="WebsiteRail"/>
                        <ToggleButton x:Name="AddWebsite" Style="{StaticResource WorkspaceTile}" Click="OnAddWebsite" ToolTip="{DynamicResource Web_Add}" AutomationProperties.Name="{DynamicResource Web_Add}"/>
                    </StackPanel></ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" x:Name="NativePageHost">
        <ui:NavigationView x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="0" CompactPaneLength="0" IsPaneOpen="True"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           FrameMargin="0"
                           Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Dashboard}" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="Home" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Watchlist}" TargetPageType="{x:Type pages:WatchlistPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="Watchlist" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Charts}" TargetPageType="{x:Type pages:ChartsPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="Charts" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Options}" TargetPageType="{x:Type pages:OptionsPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="Options" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Strategy}" TargetPageType="{x:Type pages:StrategyPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="TrendUp" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_News}" TargetPageType="{x:Type pages:NewsPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="News" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Alerts}" TargetPageType="{x:Type pages:AlertsPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="Alerts" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{DynamicResource Nav_DataSources}" TargetPageType="{x:Type pages:DataSourcesPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="DataSources" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{DynamicResource Nav_Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon><lucide:LucideIcon Kind="Settings" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
            </Grid>
            <Grid Grid.Column="1" x:Name="WebTabHost" Visibility="Collapsed"/>
        </Grid>

        <!-- D2: keyboard wizard — type a symbol anywhere, Enter opens its K-line, Esc closes -->
        <Border x:Name="Wizard" Grid.Row="1" Panel.ZIndex="10" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="14,10" MinWidth="380"
                CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                AutomationProperties.AutomationId="KeyboardWizard">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Kb_WizardTitle}" Margin="0,0,0,6" />
                <controls:SymbolBox x:Name="WizardBox" AutomationProperties.AutomationId="KeyboardWizardSymbol" MinWidth="350" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBarSurface" Grid.Row="2" Padding="16,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel x:Name="ShellUtilities" DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="SettingsButton" Style="{StaticResource StatusToggle}" Click="OnSettings" ToolTip="{DynamicResource Nav_Settings}" AutomationProperties.Name="{DynamicResource Nav_Settings}"/>
                    <Button x:Name="LanguageButton" Style="{StaticResource StatusAction}" Click="OnToggleLanguage" ToolTip="{DynamicResource Title_ToggleLanguage}" AutomationProperties.Name="{DynamicResource Title_ToggleLanguage}"/>
                    <Button x:Name="ThemeButton" Style="{StaticResource StatusAction}" Click="OnToggleTheme" ToolTip="{DynamicResource Title_ToggleTheme}" AutomationProperties.Name="{DynamicResource Title_ToggleTheme}"/>
                    <Button x:Name="BackgroundButton" Style="{StaticResource StatusAction}" Click="OnBackground" ToolTip="{DynamicResource Bg_Run}" AutomationProperties.Name="{DynamicResource Bg_Run}"/>
                    <ToggleButton x:Name="MotionButton" Style="{StaticResource StatusToggle}" Click="OnToggleMotion" ToolTip="{DynamicResource Web_Motion}" AutomationProperties.Name="{DynamicResource Web_Motion}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AppHelp x:Name="MarketStatusIndicator" Height="{StaticResource StatusItemHeight}" MinHeight="{StaticResource StatusItemHeight}" Style="{StaticResource StatusEntry}" Width="Auto" HelpText="{Binding MarketStatusTip}" MinWidth="0" Padding="4,0" Margin="0,0,12,0" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="MarketStatusIndicator" AutomationProperties.Name="{Binding MarketStatusTip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0" Fill="{Binding SourcesBrush}"/><TextBlock Style="{StaticResource StatusText}" x:Name="StatusMarketText" Text="{Binding MarketStatusText}" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
                    </controls:AppHelp>
                    <TextBlock Style="{StaticResource StatusText}" x:Name="StatusClockText" Text="{Binding ClockText}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateStatusIndicator" Style="{StaticResource StatusEntry}" Visibility="{Binding HasAvailableUpdate,Converter={StaticResource BoolToVis}}" Command="{Binding OpenUpdatePromptCommand}" MinWidth="0" Padding="8,0" Margin="0,0,12,0" ToolTip="{DynamicResource Upd_ViewUpdate}" AutomationProperties.AutomationId="UpdateStatusIndicator" AutomationProperties.Name="{Binding UpdateBadgeText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><lucide:LucideIcon VerticalAlignment="Center" Kind="Download" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Style="{StaticResource StatusText}" x:Name="StatusUpdateText" Text="{Binding UpdateBadgeText}" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="McpStatusIndicator" Style="{StaticResource StatusEntry}" Command="{Binding CopyMcpSetupCommand}" MinWidth="0" Padding="4,0" Margin="0,0,12,0" Background="Transparent" BorderThickness="0" ToolTip="{Binding McpStatusTip}" AutomationProperties.AutomationId="McpStatusIndicator" AutomationProperties.Name="{DynamicResource Set_AiUniversal}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0" Fill="{Binding McpStatusBrush}"/><TextBlock Style="{StaticResource StatusText}" x:Name="StatusMcpText" Text="{Binding McpStatusText}" TextWrapping="NoWrap"/><lucide:LucideIcon VerticalAlignment="Center" Kind="Copy" Width="10" Height="10" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
                    </Button>


                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
