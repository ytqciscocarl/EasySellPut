<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Generated design metrics and typography. -->
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="StatusItemHeight">24</x:Double>
    <x:Double x:Key="StatusLineHeight">16</x:Double>
    <x:Double x:Key="StatusDotSize">6</x:Double>
    <x:Double x:Key="BodyFontSize">15</x:Double>
    <x:Double x:Key="SubtitleFontSize">16</x:Double>
    <x:Double x:Key="TitleFontSize">20</x:Double>
    <x:Double x:Key="DisplayFontSize">30</x:Double>
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="ComfortableControlHeight">36</x:Double>
    <x:Double x:Key="ControlRadius">8</x:Double>
    <x:Double x:Key="CardRadius">16</x:Double>
    <x:Double x:Key="ModalRadius">20</x:Double>
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceSM">8</x:Double>
    <x:Double x:Key="SpaceMD">12</x:Double>
    <x:Double x:Key="SpaceLG">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="Space2XL">32</x:Double>
    <x:Double x:Key="MotionFastMs">120</x:Double>
    <x:Double x:Key="MotionStandardMs">180</x:Double>
    <x:Double x:Key="MotionEnterMs">220</x:Double>
    <x:Double x:Key="FormFieldWidth">260</x:Double>
    <x:Double x:Key="WindowHeaderHeight">36</x:Double>
    <sys:TimeSpan x:Key="MotionFastDuration">0:0:0.120</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionStandardDuration">0:0:0.180</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionEnterDuration">0:0:0.220</sys:TimeSpan>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="ModalCornerRadius">20</CornerRadius>
    <FontFamily x:Key="AppFont">avares://MeiliMac/Assets/Fonts#Source Sans 3, PingFang SC, Noto Sans CJK SC, Arial</FontFamily>
    <FontFamily x:Key="NumberFont">avares://MeiliMac/Assets/Fonts#Source Sans 3, PingFang SC, Noto Sans CJK SC, Arial</FontFamily>
    <FontFamily x:Key="HeadingFont">avares://MeiliMac/Assets/Fonts#Source Serif 4, PingFang SC, Noto Sans CJK SC, Arial</FontFamily>
    <FontFamily x:Key="CodeFont">avares://MeiliMac/Assets/Fonts#Source Code Pro, PingFang SC, Noto Sans CJK SC, Arial</FontFamily>
</ResourceDictionary>
