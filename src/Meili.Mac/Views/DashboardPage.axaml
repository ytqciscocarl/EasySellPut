<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:lucide="using:Meili.Mac.Views.Controls"
    xmlns:ds="using:Meili.Mac.Views.Controls"
    xmlns:ux="using:Meili.Mac.Views.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meili.Shared.ViewModels"
             xmlns:sp="using:ScottPlot.Avalonia"
             xmlns:local="using:Meili.Mac.Views"
             x:Class="Meili.Mac.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer Classes="PageScroller">
        <StackPanel MaxWidth="1200">
            <TextBlock Classes="PageTitle" Text="{DynamicResource Nav_Dashboard}" />


            <!-- Hero -->


            <!-- D7: getting started (network/proxy, watchlist, options) until dismissed -->
            <ds:AppCard Classes="Card" Padding="12" Margin="0,12,0,0" IsVisible="{Binding ShowGuide}" AutomationProperties.AutomationId="DashGuide"><DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Classes="Subtle" Command="{Binding DismissGuideCommand}" Content="{DynamicResource Dash_GuideDismiss}" Margin="12,0,0,0"/><WrapPanel><TextBlock Classes="Caption" Text="{DynamicResource UX_QuickStart}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Command="{Binding OpenWatchlistCommand}" Content="{DynamicResource Dash_Guide2Btn}" Margin="0,0,8,0"/><Button Command="{Binding OpenOptionsCommand}" Content="{DynamicResource Dash_Guide3Btn}" Margin="0,0,8,0"/><Button Command="{Binding OpenDataSourcesCommand}" Content="{DynamicResource Dash_OpenSources}" Margin="0,0,8,0"/></WrapPanel></DockPanel></ds:AppCard>

            <!-- Market overview (quotes via failover) -->
            <DockPanel Margin="0,24,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Classes="SectionTitle" Margin="0" VerticalAlignment="Center" Text="{DynamicResource Dash_Market}" />
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Padding="12,6" IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal">
                        <lucide:LucideIcon Kind="Refresh"  Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Dash_Refresh}" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Right" Classes="Caption" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding StatusText}" />
            </DockPanel>
            <!-- D8: every source failed — prices below are the last ones received -->
            <Border Classes="ErrorBar" IsVisible="{Binding AllSourcesFailed}" Margin="0,0,0,12" AutomationProperties.AutomationId="DashAllFailed">
<StackPanel>
<TextBlock Classes="CardTitle" Text="{DynamicResource Dash_AllFailedTitle}" />
<TextBlock Classes="Body" Text="{Binding FailureBody}" Margin="0,4,0,0" />
<ContentControl Margin="0,8,0,0">
                <WrapPanel>
                    <Button Margin="0,0,8,0" Command="{Binding RedetectProxyCommand}" Content="{DynamicResource Dash_Redetect}" Padding="10,4"
                               IsVisible="{Binding ProxyMissing}" />
                    <Button Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}" Content="{DynamicResource Dash_OpenSettings}" Padding="10,4"
                               IsVisible="{Binding ProxyMissing}" />
                    <Button Command="{Binding OpenDataSourcesCommand}" Content="{DynamicResource Dash_OpenSources}" Padding="10,4" />
                </WrapPanel>
            </ContentControl>
</StackPanel>
</Border>
            <ItemsControl ItemsSource="{Binding Quotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuoteCardViewModel">
                        <ds:AppCard Classes="Card" Margin="0,0,8,8" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Margin="6,0,0,0" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).OpenChartCommand}" CommandParameter="{Binding Symbol}" AutomationProperties.Name="{Binding ChartActionLabel}" ToolTip.Tip="{Binding ChartActionLabel}"><ux:LucideIcon Kind="Charts" Width="16" Height="16"/></Button><TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            ToolTip.Tip="{Binding TimingTip}">
                                        <TextBlock Classes="Caption" Text="{Binding SourceText}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Classes="Caption" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,8" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PriceText}" FontFamily="{DynamicResource NumberFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="8,2" Background="{Binding ChangeBackground}">
                                        <TextBlock Text="{Binding ChangeText}" FontFamily="{DynamicResource NumberFont}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ChangeBrush}" />
                                    </Border>
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="6,1" Background="{DynamicResource StaleBadgeBrush}"
                                            IsVisible="{Binding IsStale}" ToolTip.Tip="{Binding StaleTip}"
                                            AutomationProperties.AutomationId="StaleBadge">
                                        <TextBlock Text="{DynamicResource Quote_Stale}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BadgeTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                    <TextBlock Classes="Caption" Text="{Binding ExtText}" />
                                    <TextBlock Classes="Caption" Text="{Binding AsOfText}" ToolTip.Tip="{Binding TimingTip}" />
                                </StackPanel>
                            </Grid>
                        </ds:AppCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
