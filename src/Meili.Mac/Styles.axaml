<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Text roles (same names as the Windows styles). Minimum size 12. -->
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}"/>
        <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style Selector="TextBlock.CardTitle">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Body">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Secondary">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.StatusText">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/><Setter Property="LineHeight" Value="{StaticResource StatusLineHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="ScrollViewer.PageScroller">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="32,24,32,32" />
    </Style>
    <!-- Cards and message bars (the Windows build uses WPF-UI Card / InfoBar). -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.ErrorBar">
        <Setter Property="Background" Value="{DynamicResource ErrorBarBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.InfoBar">
        <Setter Property="Background" Value="{DynamicResource InfoBarBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.Tag">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.Stale">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Background" Value="{DynamicResource StaleBadgeBrush}" />
    </Style>
    <Style Selector="Border.Stale > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
    </Style>
    <!-- Center the content slot, independent of glyph/font metrics or template defaults. -->
    <Style Selector="Button, ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.Subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button, ToggleButton, TextBox, ComboBox, CheckBox, RadioButton, NumericUpDown, DatePicker, ToggleSwitch">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.Nav">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.Nav > ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- Chips: watchlist groups, range pickers, template pickers. Selected = accent. -->
    <Style Selector="Button.Chip">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.Chip.Selected">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.Chip.Selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Num">
        <Setter Property="FontFamily" Value="{DynamicResource NumberFont}" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.Popup">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="0,4" />
    </Style>
    <Style Selector="ListBox.Nav > ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector=".ChartWorkspace Button, .ChartWorkspace ToggleButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector=".ChartWorkspace ToggleButton:checked">
        <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector=".ChartWorkspace Button.Chip.Selected">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector=".ChartWorkspace Button, .ChartWorkspace ToggleButton">
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector=".ChartWorkspace Button:pointerover, .ChartWorkspace ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowHighlightBrush}" />
    </Style>
    <Style Selector=".ChartWorkspace Button:focus-visible /template/ Border#Surface, .ChartWorkspace ToggleButton:focus-visible /template/ Border#Surface">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector=".ChartWorkspace Button:disabled, .ChartWorkspace ToggleButton:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector=".ChartWorkspace #ChartToolbar Button, .ChartWorkspace #ChartToolbar ToggleButton"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="10,4"/></Style>
    <Style Selector=".ChartWorkspace #ChartToolbar Button.Icon"><Setter Property="Width" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector=".ChartWorkspace Button.DrawTool, .ChartWorkspace ToggleButton.DrawTool"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="56"/><Setter Property="MinWidth" Value="56"/><Setter Property="MinHeight" Value="56"/><Setter Property="Padding" Value="4"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
</Styles>
