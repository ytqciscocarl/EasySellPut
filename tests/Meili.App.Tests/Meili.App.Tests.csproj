<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- WPF needs one Application per process: run test classes one after another. -->
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Meili.Shared.Services" />
    <Using Include="Meili.Shared.ViewModels" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meili.App\Meili.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Fixtures/QuotePanelMarketData.cs" Link="QuotePanelMarketData.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Meili.Shared.Tests/FakeUpdates.cs" Link="FakeUpdates.cs" /></ItemGroup>
</Project>
