<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Version>0.5.3</Version>
    <Company>美丽稻谷</Company>
    <Product>EasySellPut</Product>
    <AssemblyTitle>EasySellPut</AssemblyTitle>
    <FileDescription>EasySellPut</FileDescription>
    <Copyright>Copyright (c) 2026 Carl Yu</Copyright>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
